<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIGarage.Mobile.ViewModels"
             x:Class="AIGarage.Mobile.MainPage"
             x:DataType="vm:MainViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="640">
            <Label Text="AI Garage" FontSize="30" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding ConnectionText}" />
            <Border Padding="18" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Garáž" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding DoorText}" FontSize="24" />
                    <Label Text="{Binding FreshnessText}" />
                    <Button Text="Otvoriť garáž" IsEnabled="{Binding CanOpen}" Command="{Binding OpenCommand}"
                            SemanticProperties.Hint="Vyžaduje aktuálny zatvorený stav a biometrické potvrdenie." />
                    <Label Text="Pri jednom senzore vieme potvrdiť iba zatvorenú polohu. Pohyb po impulze je odhad." FontSize="12" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="18" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Prostredie" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding TemperatureText}" />
                    <Label Text="{Binding HumidityText}" />
                    <Label Text="{Binding PressureText}" />
                </VerticalStackLayout>
            </Border>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ResultText}" />
            <Label Text="Pripojenie a prihlásenie" FontSize="20" FontAttributes="Bold" />
            <Picker Title="Režim pripojenia" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditSettings}">
                <Picker.Items>
                    <x:String>Cloud (Štádium 1)</x:String>
                    <x:String>Súkromný broker (Štádium 2)</x:String>
                </Picker.Items>
            </Picker>
            <Entry Text="{Binding Host, Mode=TwoWay}" Placeholder="Hostname MQTT brokera" Keyboard="Url" IsTextPredictionEnabled="False" IsEnabled="{Binding CanEditSettings}" />
            <Entry Text="{Binding Port, Mode=TwoWay}" Placeholder="TLS port" Keyboard="Numeric" IsEnabled="{Binding CanEditSettings}" />
            <Entry Text="{Binding TopicRoot, Mode=TwoWay}" Placeholder="Koreň tém" IsTextPredictionEnabled="False" IsEnabled="{Binding CanEditSettings}" />
            <Entry Text="{Binding Username, Mode=TwoWay}" Placeholder="MQTT používateľ" IsTextPredictionEnabled="False" IsEnabled="{Binding CanEditSettings}" />
            <Entry Text="{Binding Password, Mode=TwoWay}" Placeholder="MQTT heslo" IsPassword="True" IsTextPredictionEnabled="False" IsEnabled="{Binding CanEditSettings}" />
            <Entry Text="{Binding HmacKeyHex, Mode=TwoWay}" Placeholder="HMAC kľúč (64 hex znakov)" IsPassword="True" IsTextPredictionEnabled="False" IsEnabled="{Binding CanEditSettings}" />
            <Label Text="Údaje sa uložia bezpečne v zariadení. TLS a overenie certifikátu sú povinné v oboch režimoch." FontSize="12" />
            <Button Text="Uložiť a pripojiť" Command="{Binding LoginCommand}" />
            <Button Text="Prihlásiť uloženými údajmi cez biometriu" Command="{Binding UnlockCommand}" />
            <Button Text="Odpojiť a uzamknúť" Command="{Binding LogoutCommand}" />
            <Button Text="Odstrániť uložené údaje" Command="{Binding ForgetCommand}" />
            <Label Text="{Binding BiometricText}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
